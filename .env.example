# 线上域名
SITE_URL=https://www.duaer.com

# 点物 Flow（文案 / 分镜 / 合成稿 / 口播 / 配乐）
FLOW_API_KEY=dwflow_your_key_here
FLOW_API_BASE=https://flow.dianwu.ai

TEXT_MODEL=deepseek-v4-pro
# 口播页左侧助手（C 端不写模型名）
TALK_CHAT_MODEL=deepseek-chat
SCRIPT_MODEL=gpt-6-astra
MUSIC_MODEL=suno-v5-5
# 口播只用 CosyVoice 3.5 Plus。克隆成功后 remoteVoiceId 落在 storage/voices/{id}/cosyvoice.json，之后只复用这个 id
SPEECH_MODEL=cosyvoice-v3.5-plus
# COSYVOICE_REF_URL=https://example.com/simasheng-ref.wav
# COSYVOICE_PROMPT_TEXT=参考音里说的原话

# 克隆静帧（火山方舟图片生成；C 端不写厂商名）
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128

# 成片封面（点物 Flow 出图；C 端不写厂商名）
IMAGE_MODEL=gemini-3-pro-image

# 口播不再走 Seed / openspeech
# SPEECH_VOICE=Tingting

# 本地无密钥联调合成
# FLOW_MOCK=1

# 人物/音色元数据（默认 storage/duaer.sqlite；图片和录音仍落盘）
# DUAER_SQLITE=
